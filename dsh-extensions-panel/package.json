{
    "name": "dsh-extensions-panel",
    "version": "0.1.1",
    "description": "DSH 功能栏插件：两张卡片（虚拟显示器开关、移动端访问）。入口按区域归位——注册官方 sidebar.panellist 图标 + main 中央面板（同一 id 配对）；装了 dsh-vk-suite 时改用它的左栏「功能」Tab。",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-sidebar"
            ],
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1",
        "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.5-rc.2",
        "react": "^18.2.0"
    },
    "license": "MIT",
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-side-suite.git",
        "directory": "dsh-extensions-panel"
    },
    "homepage": "https://github.com/Ln1m/dsh-side-suite/tree/main/dsh-extensions-panel#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-side-suite/issues"
    }
}
