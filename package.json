{
    "name": "dsh-lan-services",
    "version": "0.1.0",
    "description": "DSH 局域网服务管理器：自动探测 3090~3099 端口段上的复习网站等本地 HTTP 服务（server.cjs），左栏面板显示标题/局域网网址并一键托管启停进程，换网络网址自动更新；3081 移动端反代由 dsh-pocket 提供（dsh-wifi-access 作热备）。",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-sidebar"
            ],
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1",
        "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.5-rc.2",
        "react": "^18.2.0"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md"
    ],
    "license": "MIT",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "plugin",
        "lan",
        "services",
        "review-site",
        "remote-access"
    ],
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-lan-services.git"
    },
    "homepage": "https://github.com/Ln1m/dsh-lan-services#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-lan-services/issues"
    }
}
